generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Application tables

model Exercise {
  id          String   @id @default(cuid())
  name        String
  muscleGroup String   @map("muscle_group")
  createdAt   DateTime @default(now()) @map("created_at")

  routineDayExercises RoutineDayExercise[]

  @@map("exercises")
}

model Routine {
  id          String   @id @default(cuid())
  name        String
  description String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")

  days RoutineDay[]

  @@map("routines")
}

model RoutineDay {
  id        String @id @default(cuid())
  routineId String @map("routine_id")
  title     String
  focus     String
  order     Int

  routine   Routine              @relation(fields: [routineId], references: [id], onDelete: Cascade)
  exercises RoutineDayExercise[]

  @@map("routine_days")
}

model RoutineDayExercise {
  id           String @id @default(cuid())
  routineDayId String @map("routine_day_id")
  exerciseId   String @map("exercise_id")
  targetSets   Int?   @default(3) @map("target_sets")
  targetReps   Int?   @default(10) @map("target_reps")
  restSeconds  Int?   @default(90) @map("rest_seconds")
  lastWeight   Float? @default(0) @map("last_weight")
  order        Int

  routineDay RoutineDay @relation(fields: [routineDayId], references: [id], onDelete: Cascade)
  exercise   Exercise   @relation(fields: [exerciseId], references: [id])

  @@map("routine_day_exercises")
}

model Workout {
  id              String    @id @default(cuid())
  routineDayId    String?   @map("routine_day_id")
  name            String
  startedAt       DateTime  @map("started_at")
  completedAt     DateTime? @map("completed_at")
  durationSeconds Int       @default(0) @map("duration_seconds")
  totalVolume     Float     @default(0) @map("total_volume")
  totalSets       Int       @default(0) @map("total_sets")
  completedSets   Int       @default(0) @map("completed_sets")
  notes           String?

  sets WorkoutSet[]

  @@map("workouts")
}

model WorkoutSet {
  id           String  @id @default(cuid())
  workoutId    String  @map("workout_id")
  exerciseName String  @map("exercise_name")
  setNumber    Int     @map("set_number")
  weight       Float   @default(0)
  reps         Int     @default(0)
  completed    Boolean @default(false)

  workout Workout @relation(fields: [workoutId], references: [id], onDelete: Cascade)

  @@map("workout_sets")
}

model UserSetting {
  id    String @id @default(cuid())
  key   String @unique
  value String

  @@map("user_settings")
}

// Better Auth tables

model User {
  id            String   @id
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false) @map("email_verified")
  image         String?
  createdAt     DateTime @map("created_at")
  updatedAt     DateTime @map("updated_at")

  sessions Session[]
  accounts Account[]

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime @map("expires_at")
  token     String   @unique
  createdAt DateTime @map("created_at")
  updatedAt DateTime @map("updated_at")
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  userId    String   @map("user_id")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("session")
}

model Account {
  id           String    @id
  accountId    String    @map("account_id")
  providerId   String    @map("provider_id")
  userId       String    @map("user_id")
  password     String?
  accessToken  String?   @map("access_token")
  refreshToken String?   @map("refresh_token")
  idToken      String?   @map("id_token")
  expiresAt    DateTime? @map("expires_at")
  createdAt    DateTime  @map("created_at")
  updatedAt    DateTime  @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("account")
}

model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime  @map("expires_at")
  createdAt  DateTime? @map("created_at")
  updatedAt  DateTime? @map("updated_at")

  @@map("verification")
}
